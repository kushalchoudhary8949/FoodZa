# ──────────────────────────────────────────────────────────
# FoodConnect Backend — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy to .env and fill in your values. NEVER commit .env.
# ──────────────────────────────────────────────────────────

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodconnect?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/foodconnect?schema=public"

# Redis (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Authentication
# Set SKIP_FIREBASE_AUTH=true for local development without Firebase
SKIP_FIREBASE_AUTH=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (future — online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Application
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Order Configuration
MANAGER_TIMEOUT_SECONDS=60

# OTP Configuration
OTP_MAX_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10
