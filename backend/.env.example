# ──────────────────────────────────────────────────────────
# FoodConnect / FoodZa Backend — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy to .env and fill in your values. NEVER commit .env.
# ──────────────────────────────────────────────────────────

# Node Environment & Port
NODE_ENV=production
PORT=4000

# Database (PostgreSQL via Prisma & Supabase)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-compatible PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for Prisma migrations and schema push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis (for BullMQ job queues, timeout scheduling, rate limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication (Supabase Auth — Primary)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SKIP_AUTH=false

# Legacy Authentication (Firebase Admin — Optional fallback)
# Set SKIP_FIREBASE_AUTH=true for local development testing without Firebase service credentials
SKIP_FIREBASE_AUTH=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payments (Razorpay — optional / online mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS Allowed Origins (Comma-separated URLs for web panels)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Order Lifecycle Configuration
MANAGER_TIMEOUT_SECONDS=60

# OTP Configuration
OTP_MAX_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10
