# ──────────────────────────────────────────────────────────
# FoodConnect — Database Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma Client at runtime.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodconnect?schema=public"

# Direct connection URL (bypasses connection pooling).
# Required for Prisma Migrate and introspection commands.
# If you don't use a connection pooler (e.g. PgBouncer), this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/foodconnect?schema=public"
