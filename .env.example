# ════════════════════════════════════════════════════════════════════════════════
# FoodZa Platform — Global Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════
# Copy relevant sections to the respective panel or backend directory .env files.
# NEVER commit .env files containing real secrets or production credentials.
# ════════════════════════════════════════════════════════════════════════════════

# ==============================================================================
# 1. BACKEND (backend/.env)
# ==============================================================================
NODE_ENV=production
PORT=4000

# Supabase PostgreSQL (Managed Database)
# Shared transaction-mode pooler (PgBouncer port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Shared session-mode pooler (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis / Redis (BullMQ queue & timeouts)
REDIS_HOST="probable-pegasus-xxxxxx.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your-redis-password"
REDIS_TLS=true

# Authentication (Firebase Admin SDK)
SKIP_FIREBASE_AUTH=true
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Webhooks & Payments (Optional)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# CORS Configuration (All panels)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,https://your-foodza-customer.onrender.com,https://your-foodza-admin.onrender.com"

# Business Logic Settings
MANAGER_TIMEOUT_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10

# ==============================================================================
# 2. CUSTOMER FRONTEND (customer_frontend/.env.production)
# ==============================================================================
VITE_API_URL=https://foodza-bckend.onrender.com/api
VITE_SOCKET_URL=https://foodza-bckend.onrender.com

# ==============================================================================
# 3. STORE MANAGER PANEL (store-manager-panel/.env.production)
# ==============================================================================
VITE_API_URL=https://foodza-bckend.onrender.com/api
VITE_SOCKET_URL=https://foodza-bckend.onrender.com

# ==============================================================================
# 4. DELIVERY PARTNER PANEL (Delivery-Partner-Panel/.env.production)
# ==============================================================================
VITE_API_URL=https://foodza-bckend.onrender.com/api
VITE_SOCKET_URL=https://foodza-bckend.onrender.com

# ==============================================================================
# 5. ADMIN FRONTEND (Admin_frontend/.env.production)
# ==============================================================================
VITE_API_URL=https://foodza-bckend.onrender.com/api
VITE_SOCKET_URL=https://foodza-bckend.onrender.com
